# deploy.config sengaja di-gitignore karena berisi detail server.

SSH_HOST=151.106.124.200
SSH_PORT=65002
SSH_USER=u136493546
APP_PATH='$HOME/domains/bonecomtricom.net/public_html/dayli'
BACKUP_PATH='$HOME/backups-dayli'
