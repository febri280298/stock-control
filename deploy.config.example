# PHP di server tidak punya ekstensi sodium, sedangkan lcobucci/jwt
# mensyaratkannya. Aplikasi tetap jalan karena JWT-nya memakai HS256.
COMPOSER_FLAGS='--no-dev --optimize-autoloader --no-interaction --ignore-platform-req=ext-sodium'
